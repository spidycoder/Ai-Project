# Copy to .env and fill in. Get a free-tier key at https://aistudio.google.com/apikey
# LlmJudgeScorer degrades gracefully (skips itself) if GEMINI_API_KEY is
# unset, so the pipeline runs end-to-end without it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Only needed for `--target http`, i.e. pointing this at your real RAG
# Document Assistant instead of the built-in mock target.
EVAL_TARGET_URL=
